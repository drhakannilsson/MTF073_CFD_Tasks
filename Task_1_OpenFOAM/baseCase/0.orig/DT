FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      DT;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Conductivity k. The boundary values are set by the boundary conditions,
// from the boundary temperature. The cell values are set by setExprFields
// before the simulation starts (system/setExprFieldsDict), and updated
// after each iteration by the function object conductivity
// (system/controlDict). internalField is only a placeholder.

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1;

boundaryField
{
@@DTBOUNDARY@@
    frontAndBack
    {
        type            empty;
    }
}

