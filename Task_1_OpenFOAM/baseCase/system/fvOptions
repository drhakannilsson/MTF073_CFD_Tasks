FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Source term b, compiled at run time (as in Task_1_01_OpenFOAM_tutorial.md).
//
// laplacianFoam solves  ddt(T) - laplacian(DT, T) = fvOptions(T),
// where ddt(T) = 0 (steadyState, see fvSchemes). With DT = k and
// fvOptions(T) = b this is the steady heat conduction equation
//     d/dx(k dT/dx) + d/dy(k dT/dy) + b = 0.
//
// As in the course, the source integrated over a cell is split as
// b*dV = Su + Sp*T_P, with Su and Sp including the cell volume dV.
// Su goes to the right-hand side and -Sp to the diagonal coefficient aP.
// (diag += Sp gives -Sp in aP, since fvOptions(T) is on the other side
// of the equation.)

source
{
    type            scalarCodedSource;
    name            source;
    selectionMode   all;
    fields          (T);

    codeAddSup
    #{
        @@CONSTANTS@@
        const scalarField& V = mesh_.V();
        const scalarField& Tc = eqn.psi().primitiveField();
        scalarField& diag = eqn.diag();
        scalarField& source = eqn.source();
        forAll(V, celli)
        {
            const scalar T = Tc[celli];
            (void)T;
            @@SOURCECODE@@
            diag[celli] += Sp;
            source[celli] -= Su;
        }
    #};
    codeCorrect
    #{
    #};
    codeConstrain
    #{
    #};
}

