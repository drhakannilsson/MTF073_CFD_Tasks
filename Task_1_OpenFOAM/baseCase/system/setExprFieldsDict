{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Sets the conductivity k (the field DT) in the cells once, before the
// simulation starts, from the initial guess of the temperature (T = 0).
// During the simulation, it is updated by the function object conductivity
// in system/controlDict, with the same expression.

#include "caseParameters"

readFields      (T);

expressions
(
    DT
    {
        field       DT;
        variables   (@@EXPRVARIABLES@@);
        expression  #{ @@KEXPR@@ #};
        dimensions  [0 2 -1 0 0 0 0];
    }
);

