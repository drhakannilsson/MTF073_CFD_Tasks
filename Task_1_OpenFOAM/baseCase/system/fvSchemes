/*--------------------------------*- C++ -*----------------------------------*\
  MTF073 Task 1 - OpenFOAM base case. Copied and modified by t1foam.py.
  Placeholders of the form @@...@@ are replaced by t1foam.py.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The equation is steady: ddt(T) is switched off.
ddtSchemes
{
    default         steadyState;
}

// Used for the heat flux q = -k grad(T) (post-processing only)
gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
}

// The face conductivity is linearly interpolated between the cell centres
// (non-equidistant weights), as in the course code. The face gradient is
// (T_N - T_P)/|d|. "orthogonal" is used because the meshes are orthogonal.
laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         orthogonal;
}

// ************************************************************************* //
